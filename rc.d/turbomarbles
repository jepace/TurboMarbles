#!/bin/sh
#
# PROVIDE: turbomarbles
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf to enable TurboMarbles at jail start:
#
#   turbomarbles_enable="YES"
#   turbomarbles_port="3000"          # optional, default 3000
#   turbomarbles_host="127.0.0.1"     # optional, default 127.0.0.1
#   turbomarbles_origin=""            # optional, e.g. https://example.com
#   turbomarbles_user="marbles"       # optional, default marbles
#
# The service user is provisioned by deploy.sh (pw useradd), with a real
# home directory at turbomarbles_dir — daemon(8)'s -u uses setusercontext(3),
# which chdir(2)s to the user's home; FreeBSD's stock "www" account has
# pw_dir=/nonexistent, which makes setusercontext fail. A dedicated service
# account with a real home avoids that and is the more correct separation
# of duties (www is for the web server, not arbitrary app daemons).

. /etc/rc.subr

name="turbomarbles"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${turbomarbles_enable:="NO"}
: ${turbomarbles_port:="3000"}
: ${turbomarbles_host:="127.0.0.1"}
: ${turbomarbles_origin:=""}
: ${turbomarbles_user:="marbles"}
: ${turbomarbles_dir:="/var/www/marbles"}
: ${turbomarbles_log:="/var/log/turbomarbles.log"}
: ${turbomarbles_pidfile:="/var/run/turbomarbles.pid"}

pidfile="${turbomarbles_pidfile}"
command="/usr/sbin/daemon"
# -u drops privileges via setusercontext(3) (no shell, no su, no quoting).
# /usr/bin/env sets the child's environment without needing a shell to
# interpret VAR=val assignments.
command_args="-f -u ${turbomarbles_user} -p ${turbomarbles_pidfile} -o ${turbomarbles_log} \
    /usr/bin/env PORT=${turbomarbles_port} HOST=${turbomarbles_host} ORIGIN=${turbomarbles_origin} \
    /usr/local/bin/node ${turbomarbles_dir}/src/server.js"

start_precmd="turbomarbles_prestart"

turbomarbles_prestart()
{
    touch "${turbomarbles_log}"
    chown "${turbomarbles_user}" "${turbomarbles_log}"
}

run_rc_command "$1"
