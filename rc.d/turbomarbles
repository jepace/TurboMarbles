#!/bin/sh
#
# PROVIDE: turbomarbles
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf to enable TurboMarbles at jail start:
#
#   turbomarbles_enable="YES"
#   turbomarbles_port="3000"          # optional, default 3000
#   turbomarbles_host="127.0.0.1"     # optional, default 127.0.0.1
#   turbomarbles_origin=""            # optional, e.g. https://example.com
#   turbomarbles_user="marbles"       # optional, default marbles
#
# The service user is provisioned by deploy.sh (pw useradd), as a
# dedicated account rather than reusing the system "www" user — cleaner
# separation between the web server and arbitrary app daemons.
#
# Privilege drop: rc.subr has a BUILT-IN convention — if ${name}_user is
# set (here, turbomarbles_user), run_rc_command automatically wraps the
# whole command in `su -m ${turbomarbles_user} -c '...'` before executing
# it. We rely on that native mechanism and do NOT also pass daemon(8)'s
# own -u flag — doing both caused a double privilege-drop: rc.subr's su
# wrap already puts the process under the unprivileged user, so a second
# `daemon -u` then tried to setusercontext(3) from a non-root process,
# which fails with "failed to set user environment" (confirmed by testing
# the same daemon -u invocation manually, as root, where it worked fine —
# the difference was specifically the rc.subr su-wrap layering on top).
#
# Confirmed by direct testing in this jail: the pidfile directory must be
# owned by the service user, since daemon ends up running as that user
# (via the su wrap) by the time it creates the pidfile. /var/run is
# root:wheel 755, so a non-wheel user can't create a pidfile there
# directly — hence the dedicated, owned turbomarbles_piddir below.

. /etc/rc.subr

name="turbomarbles"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${turbomarbles_enable:="NO"}
: ${turbomarbles_port:="3000"}
: ${turbomarbles_host:="127.0.0.1"}
: ${turbomarbles_origin:=""}
: ${turbomarbles_user:="marbles"}
: ${turbomarbles_dir:="/var/www/marbles"}
: ${turbomarbles_log:="/var/log/turbomarbles.log"}
: ${turbomarbles_piddir:="/var/run/turbomarbles"}
: ${turbomarbles_pidfile:="${turbomarbles_piddir}/turbomarbles.pid"}

pidfile="${turbomarbles_pidfile}"
command="/usr/sbin/daemon"
# No -u here: rc.subr's native ${name}_user (turbomarbles_user) support
# already drops privileges via su -m before this command ever runs.
# /usr/bin/env sets the child's environment without needing extra shell
# quoting to interpret VAR=val assignments.
command_args="-f -p ${turbomarbles_pidfile} -o ${turbomarbles_log} \
    /usr/bin/env PORT=${turbomarbles_port} HOST=${turbomarbles_host} ORIGIN=${turbomarbles_origin} \
    /usr/local/bin/node ${turbomarbles_dir}/src/server.js"

start_precmd="turbomarbles_prestart"

turbomarbles_prestart()
{
    # Pidfile directory must be owned by turbomarbles_user — daemon -u
    # creates the pidfile as that user, after the privilege drop.
    install -d -o "${turbomarbles_user}" -m 755 "${turbomarbles_piddir}"
    touch "${turbomarbles_log}"
    chown "${turbomarbles_user}" "${turbomarbles_log}"
}

run_rc_command "$1"
