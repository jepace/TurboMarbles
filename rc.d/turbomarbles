#!/bin/sh
#
# PROVIDE: turbomarbles
# REQUIRE: NETWORKING
# KEYWORD: shutdown
#
# Add the following to /etc/rc.conf to enable TurboMarbles at jail start:
#
#   turbomarbles_enable="YES"
#
# Settings live in /usr/local/etc/turbomarbles.conf (KEY=value; see
# turbomarbles.conf.sample — deploy.sh creates it from the sample if missing).
# rc.conf only needs the line above; these remain for the service itself:
#
#   turbomarbles_config="/usr/local/etc/turbomarbles.conf"
#
# Older rc.conf overrides (still honoured; they win over the file):
#
#   turbomarbles_port="8080"          # nginx proxy_pass target port
#   turbomarbles_host="127.0.0.1"     # in a classic jail this binds the jail's IP
#   turbomarbles_origin="https://marbles.pacehouse.com"
#                                     # only WebSocket connections from this page
#                                     # are accepted; set "" to allow any origin
#   turbomarbles_trust_proxy="1"      # take the client IP from X-Forwarded-For
#                                     # (set by nginx); "" when not behind a proxy
#   turbomarbles_user="marbles"       # service account (created by deploy.sh)
#
# How it runs:
# - rc.subr's built-in ${name}_user support wraps the command in
#   `su -m turbomarbles_user`, so daemon(8) and node both run unprivileged.
#   (daemon's own -u must NOT also be used: a second privilege drop from an
#   already-unprivileged process fails with "failed to set user environment".)
# - daemon(8) supervises node: -r restarts it 5 s after any crash (-R 5),
#   -P writes the SUPERVISOR's pid, which is what rc.subr stops/checks
#   (procname defaults to $command, i.e. daemon), and -H reopens the log on
#   SIGHUP so newsyslog can rotate it. Stopping sends SIGTERM to the
#   supervisor, which stops node and exits without restarting it.
# - The pid directory is owned by the service user, because the supervisor
#   (already unprivileged) creates the pidfile; /var/run itself is root-only.

. /etc/rc.subr

name="turbomarbles"
rcvar="${name}_enable"

load_rc_config "${name}"

: ${turbomarbles_enable:="NO"}
: ${turbomarbles_config:="/usr/local/etc/turbomarbles.conf"}
: ${turbomarbles_user:="marbles"}
: ${turbomarbles_dir:="/var/www/marbles"}
: ${turbomarbles_log:="/var/log/turbomarbles.log"}
: ${turbomarbles_piddir:="/var/run/turbomarbles"}
: ${turbomarbles_pidfile:="${turbomarbles_piddir}/turbomarbles.pid"}
: ${turbomarbles_datadir:="/var/db/turbomarbles"}   # players, games, stats (SQLite)

pidfile="${turbomarbles_pidfile}"
command="/usr/sbin/daemon"
# Only settings given in rc.conf go on the command line; the rest come from the config file.
turbomarbles_env="CONFIG_FILE=${turbomarbles_config}"
[ -n "${turbomarbles_port+x}" ] && turbomarbles_env="${turbomarbles_env} PORT=${turbomarbles_port}"
[ -n "${turbomarbles_host+x}" ] && turbomarbles_env="${turbomarbles_env} HOST=${turbomarbles_host}"
[ -n "${turbomarbles_origin+x}" ] && turbomarbles_env="${turbomarbles_env} ORIGIN=${turbomarbles_origin}"
[ -n "${turbomarbles_trust_proxy+x}" ] && turbomarbles_env="${turbomarbles_env} TRUST_PROXY=${turbomarbles_trust_proxy}"
[ -n "${turbomarbles_stream_url+x}" ] && turbomarbles_env="${turbomarbles_env} STREAM_URL=${turbomarbles_stream_url}"
command_args="-f -r -R 5 -H -P ${turbomarbles_pidfile} -o ${turbomarbles_log} \
    /usr/bin/env ${turbomarbles_env} DATA_DIR=${turbomarbles_datadir} \
    /usr/local/bin/node ${turbomarbles_dir}/src/server.js"

start_precmd="turbomarbles_prestart"

turbomarbles_prestart()
{
    install -d -o "${turbomarbles_user}" -m 755 "${turbomarbles_piddir}"
    install -d -o "${turbomarbles_user}" -m 700 "${turbomarbles_datadir}"
    [ -e "${turbomarbles_config}" ] && chown "${turbomarbles_user}" "${turbomarbles_config}" && chmod 600 "${turbomarbles_config}"
    touch "${turbomarbles_log}"
    chown "${turbomarbles_user}" "${turbomarbles_log}"
    chmod 640 "${turbomarbles_log}"
}

run_rc_command "$1"
